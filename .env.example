# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
DATABASE_PASSWORD=change-me-to-a-long-random-password

# --- Security ---
# Encrypts authenticator secrets: 32 random bytes, base64.
# Leave it empty for a trial: the portal then creates one on first start and keeps it with the CV files.
# For production, set your own and keep it in a secrets manager. To generate one:
#   macOS or Linux:      openssl rand -base64 32
#   Windows PowerShell:  $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# If the key is lost, every user has to set up two-step verification again.
ETT_ENCRYPTION_KEY=
# true whenever the portal is served over HTTPS (always in production).
COOKIE_SECURE=false

# --- Web address people use (links in emails point here) ---
PORTAL_URL=http://localhost:8081
HTTP_PORT=8081

# --- Sample data ---
# "demo" loads a sample client (Pellham & Rowe, with logo), 15 CVs, partner centres and candidates at every
# step from shortlisting to offer (password Welcome@2026!). Leave empty for a clean installation.
SPRING_PROFILES_ACTIVE=demo

# --- Sample interview reports ---
# Until the AI interviewer, partner assessors and panels are connected, the portal can fill in sample reports
# (always labelled SAMPLE). HR can also click "Complete with sample report". Set to false in a live installation.
ETT_SAMPLE_REPORTS=true
# Minutes after an interview ends before a sample report is added automatically (0 = only when HR clicks).
ETT_SAMPLE_REPORT_DELAY_MINUTES=5

# --- First admin for a clean installation (ignored once any HR user exists) ---
# Remove the password from this file after the first start.
ETT_FIRST_COMPANY=
ETT_FIRST_COMPANY_COUNTRY=India
# eu, uk, us, apac or other
ETT_FIRST_COMPANY_REGION=apac
ETT_FIRST_ADMIN_NAME=
ETT_FIRST_ADMIN_EMAIL=
ETT_FIRST_ADMIN_PASSWORD=

# --- Email ---
ETT_MAIL_FROM=ETT Talent Team <no-reply@your-domain.example>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
# Email colours (hex), matching frontend/src/brand.ts
ETT_BRAND_COLOR="#0a7476"
ETT_BRAND_HEADING_COLOR="#0b2545"

# --- Data retention ---
# CV files are deleted this many days after they were added (personal data minimisation).
ETT_CV_RETENTION_DAYS=180

# --- API documentation at /api/docs/ui (keep off in production) ---
API_DOCS_ENABLED=false
